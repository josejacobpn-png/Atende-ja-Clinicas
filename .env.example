# ============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (ATENDE JÁ)
# ============================================================================
# Copie este arquivo para .env.local ou .env e preencha com suas credenciais do Supabase.
# Se estas variáveis ficarem vazias, o sistema executará em modo de Simulação Local (LocalStorage).

NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
